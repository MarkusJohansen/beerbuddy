# Copy to backend/.env

# db.ts compares this to the exact string "sqlite3". Anything else — including
# unset — selects MySQL, so a typo here fails as a connection error on :3306.
DATABASE=sqlite3

# Ignored entirely when DATABASE=sqlite3. Values below are the defaults db.ts
# falls back to, and match the user created in backend/README.md.
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASS=Password12345678*
DB_NAME=beers

# Running under docker compose? The database is another container, not this one:
# DATABASE=mysql
# DB_HOST=mysqldb
