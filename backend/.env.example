# Copy to backend/.env (or run `make env`).
#
# Under compose these are set by compose.yaml and this file only needs to exist.
# The values below are for running the backend directly on the host against the
# database compose publishes on 5433.

# Required. The server exits at startup naming this variable if it is unset,
# rather than starting and failing on every request.
DATABASE_URL=postgres://beerbuddy:beerbuddy@localhost:5433/beers

# Comma-separated origin allowlist. There is no wildcard default.
CORS_ORIGINS=http://localhost:5173

PORT=3000

# Seconds a cached GET response stays fresh. Writes are never cached.
CACHE_TTL_SECONDS=300

# Set only in the production image, where the backend also serves the frontend.
# STATIC_DIR=/app/public
