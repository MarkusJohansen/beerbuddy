# Copy to frontend/.env — the app does not work without this.
# Vite exposes only VITE_-prefixed names, and reads them at build time:
# restart the dev server after changing this file.

# The full GraphQL endpoint URL, interpolated into every fetch in the app.
VITE_APP_BACKEND_URL=http://localhost:3000/graphql

# To develop against the deployed backend instead (needs the NTNU network or VPN,
# and writes to the shared production database):
# VITE_APP_BACKEND_URL=http://it2810-15.idi.ntnu.no:3000/graphql
