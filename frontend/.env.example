# Copy to frontend/.env (or run `make env`).
#
# Vite exposes only VITE_-prefixed names and reads them at build time, so restart
# the dev server after changing this file. There is no default: the build fails if
# it is unset, rather than emitting a bundle that fetches undefined.

VITE_APP_BACKEND_URL=http://localhost:3000/api
